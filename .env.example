# BAP is the default. Use local to retain the resident Google Chrome workflow.
FLYPORTER_BROWSER=bap
BROWSERLESS_TOKEN=
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io/stealth/bql
PORTER_USERNAME=
PORTER_PASSWORD=
# Credential aliases: FLYPORTER_USERNAME/PASSWORD, then USERNAME/PASSWORD.
# Token alias: BROWSERLESS_API_TOKEN. Shell values take precedence over .env.

# Disconnected browser retention: milliseconds, default 60 seconds; 0 disables reuse.
# Idle time and each reconnect are billable. This does not extend Porter's authentication TTL.
BAP_RECONNECT_TIMEOUT_MS=60000
BAP_TIMEOUT_MS=60000
BAP_CAPTCHA_TIMEOUT_MS=10000
# Opt-in redacted debug events, masked screenshots and control metadata (including on failure).
FLYPORTER_DEBUG=0
ARTIFACTS_DIR=artifacts
# Defaults to ~/.config/flyporter/<account-scope>. Contains sensitive session references.
FLYPORTER_STATE_DIR=

# Optional selectors, using defaults observed in the proof of concept.
PORTER_USERNAME_SELECTOR=
PORTER_PASSWORD_SELECTOR=
PORTER_LOGIN_SUBMIT_SELECTOR=
PORTER_ONE_WAY_SELECTOR=
PORTER_PASSENGER_SELECTOR=
PORTER_ORIGIN_SELECTOR=
PORTER_ORIGIN_OPTION_SELECTOR=
PORTER_DESTINATION_SELECTOR=
PORTER_DESTINATION_OPTION_SELECTOR=
PORTER_DEPARTURE_DATE_SELECTOR=
PORTER_SEARCH_SUBMIT_SELECTOR=
PORTER_RESULTS_SELECTOR=
PORTER_DATE_FORMAT=MM/DD/YYYY

# Local Playwright backend only; blank values use platform defaults.
FLYPORTER_CHROME_PROFILE=
FLYPORTER_CHROME_DEBUG_PORT=9223
FLYPORTER_CHROME_PATH=
